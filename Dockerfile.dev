FROM golang:1.26

# Install build dependencies for CGO (sqlite-vec), protoc, and Node.js (for MCP servers)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-dev \
    protobuf-compiler \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI (for dynamic tool generation)
RUN npm install -g @anthropic-ai/claude-code

# Install Air for hot reloading
RUN go install github.com/air-verse/air@latest

# Install protoc Go plugins
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

WORKDIR /app

# Pre-download dependencies (cached layer)
COPY go.mod go.sum ./
RUN go mod download

# Source code is bind-mounted at runtime
ENTRYPOINT ["air"]
