# suzuha configuration template
# Copy to config.yaml and fill in your values:
#   cp config.yaml.example config.yaml

# IANA timezone for cron schedules, quiet hours, and time display.
# Defaults to UTC if omitted.
timezone: "Asia/Tokyo"

llm:
  provider: "openai"           # legacy: 起動時のデフォルトプロバイダ
  model: "gpt-4.1-mini"
  api_key: ""                  # Set in .env as LLM_API_KEY
  max_tokens: 100000
  # プロバイダ接続定義 (API キーは環境変数で管理)
  providers:
    - name: openai
      type: openai
      api_base: "https://api.openai.com/v1"
    # - name: zhipu
    #   type: zhipu
    #   api_base: "https://open.bigmodel.cn/api/coding/paas/v4"
    # - name: local
    #   type: openai
    #   api_base: "http://host.docker.internal:8000/v1"

discord:
  token: "${DISCORD_TOKEN}"
  bot_id: ""

memory:
  db_path: "/data/memory.db"   # Docker volume path

agent:
  system_prompt: "You are Suzuha, a friendly AI assistant."
  interest_threshold: 0.5
  context_window_pct: 0.8

consolidator:
  address: "consolidator:50051"  # Docker Compose service name
  agent_notify: "agent:50052"    # Agent notification gRPC address
  scheduler:
    enabled: true
    timezone: "Asia/Tokyo"         # IANA timezone for quiet hours & cron interpretation
    quiet_hours:
      enabled: true
      start: "23:00"               # Suppress notifications from 23:00
      end: "08:00"                 # ... until 08:00 (in configured timezone)
    jobs:
      # - name: "topics-daily"
      #   task: "topics"
      #   cron: "0 10 * * *"          # Every day at 10:00
      #   config:
      #     channel_id: "YOUR_CHANNEL_ID"
      #     prompt_dir: "/data/prompts" # Directory containing IDENTITY.md / SOUL.md
      #     topics:
      #       - "最近ハマっていること"
      #       - "おすすめの技術書・記事"
      #       - "週末の予定"
      #       - "最近作ったもの"

observe:
  log_level: "debug"
  internal_addr: ":9090"

tool_servers: []

triggers: []
