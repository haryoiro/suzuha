# suzuha configuration template
# Copy to config.yaml and fill in your values:
#   cp config.yaml.example config.yaml

llm:
  provider: "openai"           # "openai", "anthropic", etc.
  model: "gpt-4"
  api_key: ""  # Set in .env as LLM_API_KEY, or fill in directly
  max_tokens: 8000

discord:
  token: "${DISCORD_TOKEN}"
  bot_id: ""

memory:
  db_path: "/data/memory.db"   # Docker volume path

agent:
  system_prompt: "You are Suzuha, a friendly AI assistant."
  interest_threshold: 0.5
  context_window_pct: 0.8

consolidator:
  address: "consolidator:50051"  # Docker Compose service name
  agent_notify: "agent:50052"    # Agent notification gRPC address
  scheduler:
    enabled: true
    timezone: "Asia/Tokyo"         # IANA timezone for quiet hours & cron interpretation
    quiet_hours:
      enabled: true
      start: "23:00"               # Suppress notifications from 23:00
      end: "08:00"                 # ... until 08:00 (in configured timezone)
    jobs:
      # - name: "topics-daily"
      #   task: "topics"
      #   cron: "0 10 * * *"          # Every day at 10:00
      #   config:
      #     channel_id: "YOUR_CHANNEL_ID"
      #     prompt_dir: "/data/prompts" # Directory containing IDENTITY.md / SOUL.md
      #     topics:
      #       - "最近ハマっていること"
      #       - "おすすめの技術書・記事"
      #       - "週末の予定"
      #       - "最近作ったもの"

observe:
  log_level: "debug"
  metrics_addr: ":9090"

tool_servers: []

triggers: []
